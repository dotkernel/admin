{% from '@partial/macros.html.twig' import inputElement, submitElement %}

{% extends '@layout/default.html.twig' %}

{% block title %}Account{% endblock %}

{% block content %}
    <div class="row gap-20 pos-r">
        <div class="col-md-6">
            <div class="bgc-white p-20 bd">
                <h6 class="c-grey-900">Update personal data</h6>
                <div class="mT-30">
                    {{ form().openTag(accountForm)|raw }}
                    {{ inputElement(accountForm.get('identity')) }}
                    {{ inputElement(accountForm.get('firstName')) }}
                    {{ inputElement(accountForm.get('lastName')) }}
                    {{ inputElement(accountForm.get('accountCsrf')) }}
                    {{ submitElement(accountForm.get('submit')) }}
                    {{ form().closeTag()|raw }}
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="bgc-white p-20 bd">
                <h6 class="c-grey-900">Change password</h6>
                <div class="mT-30">
                    {{ form().openTag(changePasswordForm)|raw }}
                    {{ inputElement(changePasswordForm.get('currentPassword')) }}
                    {{ inputElement(changePasswordForm.get('password')) }}
                    {{ inputElement(changePasswordForm.get('passwordConfirm')) }}
                    {{ inputElement(changePasswordForm.get('changePasswordCsrf')) }}
                    {{ submitElement(changePasswordForm.get('submit')) }}
                    {{ form().closeTag()|raw }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
