{% from '@partial/macros.html.twig' import inputElement, multiCheckboxElement, submitElement %}

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title" id="edit-admin-modal-content">Edit admin</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        {{ form().openTag(form)|raw }}
        {{ inputElement(form.get('identity')) }}
        {{ inputElement(form.get('password')) }}
        {{ inputElement(form.get('passwordConfirm')) }}
        {{ inputElement(form.get('firstName')) }}
        {{ inputElement(form.get('lastName')) }}
        {{ inputElement(form.get('status')) }}
        {{ multiCheckboxElement(form.get('roles')) }}
        {{ inputElement(form.get('adminEditCsrf')) }}
        {{ submitElement(form.get('submit')) }}
        {{ form().closeTag()|raw }}

        {% if messages is defined and messages is iterable %}
            {% for type, message in messages %}
                <div class="mt-3 alert alert-{% if type == 'success' %}success{% elseif type == 'warning' %}warning{% else %}danger{% endif %}" role="alert">{{ message }}</div>
            {% endfor %}
        {% endif %}
    </div>
</div>
