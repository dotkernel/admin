{% from '@partial/macros.html.twig' import sortableColumn %}

{% extends '@layout/default.html.twig' %}

{% block title %}Admin logins{% endblock %}

{% block content %}
    <div class="container-fluid">
        <h4 class="c-grey-900 mT-10 mB-30">Admin logins</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="bgc-white bd bdrs-3 p-20 mB-20">
                    <form class="row g-3" method="get" action="{{ path('admin::admin-login-list') }}">
                        <input type="hidden" name="offset" value="0" />
                        <input type="hidden" name="limit" value="{{ params.limit }}" />
                        <input type="hidden" name="sort" value="{{ params.sort }}" />
                        <input type="hidden" name="order" value="{{ params.order }}" />
                        <div class="col-sm-auto">
                            <select class="form-select form-select-sm"
                                    aria-label="Identity selector"
                                    id="identitySelector"
                                    name="identity">
                                <option value="">Select identity ({{ identities|length }})</option>
                                {% for identity in identities %}
                                <option value="{{ identity }}" {{ identity == params.identity ? 'selected' : '' }}>{{ identity }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-sm-auto">
                            <select class="form-select form-select-sm"
                                    aria-label="Status selector"
                                    id="statusSelector"
                                    name="status">
                                <option value="">Select status</option>
                                {% for status in statuses %}
                                <option value="{{ status }}" {{ status == params.status ? 'selected' : '' }}>{{ status }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-sm-auto">
                            <button type="submit" class="btn btn-primary btn-sm mb-3">
                                <i class="ti-search"></i> Filter
                            </button>
                            <a href="{{ path('admin::admin-login-list') }}" class="btn btn-secondary btn-sm mb-3">
                                <i class="fa fa-undo"></i> Reset
                            </a>
                        </div>
                        <div class="col-sm-auto ms-auto">
                            <div class="dropdown"
                                 data-bs-toggle="tooltip"
                                 data-bs-placement="top"
                                 data-bs-custom-class="custom-tooltip"
                                 data-bs-title="Toggle columns">
                                <button class="btn btn-light btn-sm dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="ti-view-list-alt"></i>
                                </button>
                                <ul class="dropdown-menu" id="column-selector"></ul>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-md-12">
                <div class="table-responsive">
                    <table id="admin-logins-table" class="table table-bordered table-hover table-striped table-light">
                        <thead>
                            <tr>
                                <th class="column-identity">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'identity', 'Identity') }}
                                </th>
                                <th class="column-adminIp text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'adminIp', 'Ip Address') }}
                                </th>
                                <th class="column-loginStatus">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'loginStatus', 'Status') }}
                                </th>
                                <th class="column-country">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'country', 'Country') }}
                                </th>
                                <th class="column-continent">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'continent', 'Continent') }}
                                </th>
                                <th class="column-organization">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'organization', 'Organization') }}
                                </th>
                                <th class="column-deviceType text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'deviceType', 'Device Type') }}
                                </th>
                                <th class="column-deviceBrand text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'deviceBrand', 'Device Brand') }}
                                </th>
                                <th class="column-deviceModel text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'deviceModel', 'Device Model') }}
                                </th>
                                <th class="column-isMobile text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'isMobile', 'Is Mobile') }}
                                </th>
                                <th class="column-osName text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'osName', 'Os Name') }}
                                </th>
                                <th class="column-osVersion text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'osVersion', 'Os Version') }}
                                </th>
                                <th class="column-osPlatform text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'osPlatform', 'Os Platform') }}
                                </th>
                                <th class="column-clientType text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'clientType', 'Client Type') }}
                                </th>
                                <th class="column-clientName text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'clientName', 'Client Name') }}
                                </th>
                                <th class="column-clientEngine text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'clientEngine', 'Client Engine') }}
                                </th>
                                <th class="column-clientVersion text-nowrap">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'clientVersion', 'Client Version') }}
                                </th>
                                <th class="column-created">
                                    {{ sortableColumn('admin::admin-login-list', {}, params, 'created', 'Created') }}
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for login in logins %}
                            <tr class="table-row">
                                <td class="column-identity">{{ login.identity }}</td>
                                <td class="column-adminIp">{{ login.adminIp }}</td>
                                <td class="column-loginStatus">
                                    {% if login.loginStatus == 'success' %}
                                    <span class="badge text-bg-success">Success</span>
                                    {% else %}
                                    <span class="badge text-bg-danger">Failed</span>
                                    {% endif %}
                                </td>
                                <td class="column-country">{{ login.country }}</td>
                                <td class="column-continent">{{ login.continent }}</td>
                                <td class="column-organization">{{ login.organization }}</td>
                                <td class="column-deviceType">{{ login.deviceType }}</td>
                                <td class="column-deviceBrand">{{ login.deviceBrand }}</td>
                                <td class="column-deviceModel">{{ login.deviceModel }}</td>
                                <td class="column-isMobile">
                                    {% if login.isMobile == 'yes' %}
                                    <span class="badge text-bg-primary">Yes</span>
                                    {% else %}
                                    <span class="badge text-bg-secondary">No</span>
                                    {% endif %}
                                </td>
                                <td class="column-osName">{{ login.osName }}</td>
                                <td class="column-osVersion">{{ login.osVersion }}</td>
                                <td class="column-osPlatform">{{ login.osPlatform }}</td>
                                <td class="column-clientType">{{ login.clientType }}</td>
                                <td class="column-clientName">{{ login.clientName }}</td>
                                <td class="column-clientEngine">{{ login.clientEngine }}</td>
                                <td class="column-clientVersion">{{ login.clientVersion }}</td>
                                <td class="column-created">{{ login.created }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% if pagination.isOutOfBounds() %}
                    <div class="alert alert-warning text-center text-black fw-bold" role="alert">
                        Out of bounds! Return to
                        <a href="{{ path('admin::admin-login-list', {}, params|merge({offset: pagination.getLastOffset()})) }}">page {{ pagination.getLastPage() }}</a>
                    </div>
                    {% endif %}
                </div>
            </div>
            <div class="col-md-12">
                <div class="bgc-white bd bdrs-3 p-20 mB-20">
                    {{ include('@partial/pagination.html.twig', {pagination: pagination, path: 'admin::admin-login-list', params: params}, false) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascript %}
{{ parent() }}
<script>
    const tableId = '#admin-logins-table';
    const storeSettingsUrl = '{{ path('setting::setting-store', {identifier: identifier}) }}';
    const getSettingsUrl = '{{ path('setting::setting-view', {identifier: identifier}) }}';
</script>
<script src="{{ asset('js/table_settings.js') }}" defer></script>
{% endblock %}
