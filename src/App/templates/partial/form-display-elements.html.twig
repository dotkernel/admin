{% set submit = null %}
{% if showLabels is not defined %}
    {% set showLabels = false %}
{% endif %}

{% for k, v in form.getElements() %}
    {% set element = form.get(k) %}

    {% if element is Submit or element is Button and element.getName() == 'submit' %}
        {% set dummy = element.setAttribute('class', 'btn btn-primary btn-color btn-sm') %}
        {% set submit = element %}
    {% endif %}

    {% if element is Captcha %}
        <div class="col-md-12">
            {% set dummy = element.setAttribute('class', 'form-control-sm') %}

            {% if showLabels and element.getLabel() is defined and element.getLabel() is not empty %}
                {{ formLabel(element) }}
            {% endif %}

            {{ formCaptcha(element) }}

        </div>
    {% elseif element is MultiCheckbox %}
        {% set dummy = element.setAttribute('class', 'form-check-input') %}
        {% set dummy = element.setLabelAttributes([]|merge({class: 'form-label mR-25'})) %}
        {% if element.getMessages() is not empty and element.getMessages() is iterable %}
            {% set dummy = element.setAttributes([]|merge({class: 'form-check-input is-invalid'})) %}
        {% endif %}

        <div class="col-md-12">
            {{ formLabel(element) }}
            <br>
            <div class="form-check form-check-inline">
                {{ formElement(element) }}
            </div>

            {% if element.getMessages() is not empty and element.getMessages() is iterable %}
                <div class="invalid-feedback d-block">
                    {% for message in element.getMessages() %}
                        {{ message|raw }} <br>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

    {% elseif element is Checkbox %}
        {% set dummy = element.setAttribute('class', 'form-check-input') %}
        <div class="form-check form-check-inline">
            <label class="form-label">
                {{ element.getLabel() }} {{ formCheckbox(element) }}
            </label>
        </div>

    {% elseif element is Hidden %}

        {{ formElement(element) }}

    {% elseif element is Button and element.getName() != 'submit' %}

        {{ formButton(element) }}

    {% else %}
        {% if element is not Submit or (element is Button and element.getName() != 'submit') %}
        <div class="col-md-12">
            {% set dummy = element.setAttribute('class', 'form-control form-control-sm') %}
            {% set dummy = element.setLabelAttributes([]|merge({class: 'form-label'})) %}

            {% if showLabels and element.getLabel() is defined and element.getLabel() is not empty %}
                {{ formLabel(element) }}
            {% endif %}

            {% if element.getMessages() is not empty and element.getMessages() is iterable %}
                {% set dummy = element.setAttributes([]|merge({class: 'form-control form-control-sm is-invalid'})) %}
            {% endif %}

            {{ formElement(element) }}

            {% if element.getMessages() is not empty and element.getMessages() is iterable %}
            <div class="invalid-feedback">
                {% for message in element.getMessages() %}
                    {{ message|raw }} <br>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% endif %}
    {% endif %}
{% endfor %}

{% if submit is defined and submit is not null %}
    <div class="col-md-12">
        <div class="d-flex justify-content-end">
            {{ formSubmit(submit) }}
        </div>
    </div>
{% endif %}
